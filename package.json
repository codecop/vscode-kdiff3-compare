{
  "name": "kdiff3-compare",
  "displayName": "KDiff3 Compare",
  "description": "Compare two selected files with KDiff3 (Compare Selected in the Explorer context menu).",
  "version": "0.1.0",
  "publisher": "codecop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codecop/vscode-kdiff3-compare.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kdiff3.compareSelected",
        "title": "Compare Selected with KDiff3",
        "category": "KDiff3"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "kdiff3.compareSelected",
          "when": "listDoubleSelection",
          "group": "3_compare@5"
        }
      ]
    },
    "configuration": {
      "title": "KDiff3 Compare",
      "properties": {
        "kdiff3Compare.kdiff3Path": {
          "type": "string",
          "default": "kdiff3",
          "markdownDescription": "Path to the KDiff3 executable, e.g. `C:\\Program Files\\KDiff3\\kdiff3.exe` (Windows) or `/usr/bin/kdiff3` (Linux/macOS). The default `kdiff3` uses the PATH variable."
        }
      }
    }
  }
}
